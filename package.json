{
  "name": "jpl-portfolio-backend",
  "version": "1.0.0",
  "description": "Standalone backend API server for JPL IT Solution Portfolio",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "node scripts/seed-db.js",
    "test:db": "node scripts/test-db-connection.js",
    "test:api": "node scripts/test-apis.js",
    "pm2:start": "pm2 start ecosystem.config.js --env production",
    "pm2:stop": "pm2 stop ecosystem.config.js",
    "pm2:restart": "pm2 restart ecosystem.config.js",
    "pm2:logs": "pm2 logs jpl-backend",
    "pm2:status": "pm2 status"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.11.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "pm2": "^7.0.4",
    "prisma": "^5.22.0"
  },
  "keywords": [
    "express",
    "prisma",
    "jpl",
    "backend"
  ],
  "author": "JPL IT Solution",
  "license": "ISC"
}
