datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Admin {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Blog {
  id              String    @id @default(uuid())
  slug            String    @unique
  title           String
  excerpt         String    @db.Text
  content         String    @db.LongText
  featuredImage   String?   @db.LongText
  category        String    @default("Technology")
  author          String    @default("JPL Team")
  status          String    @default("published")
  allowComments   Boolean   @default(true) // Comment on/off
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // SEO Fields
  seoTitle        String?
  metaDescription String?   @db.Text
  focusKeyword    String?
  canonicalUrl    String?   @db.Text
  ogTitle         String?
  ogDescription   String?   @db.Text
  ogImage         String?   @db.LongText
  noIndex         Boolean   @default(false)
  noFollow        Boolean   @default(false)

  comments        Comment[]
}

model Comment {
  id            String    @id @default(uuid())
  blogId        String
  blog          Blog      @relation(fields: [blogId], references: [id], onDelete: Cascade)
  parentId      String?   // For nested reply to another comment
  parent        Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies       Comment[] @relation("CommentReplies")
  authorName    String    // comment by
  authorContact String    // contact (email / phone)
  content       String    @db.Text // comment content
  status        String    @default("approved") // approved, pending, spam
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([blogId])
  @@index([parentId])
}

model Category {
  id        String   @id @default(uuid())
  name      String   @unique
  slug      String   @unique
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Tag {
  id        String   @id @default(uuid())
  name      String   @unique
  slug      String   @unique
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model JobOpening {
  id                 String           @id @default(uuid())
  title              String
  department         String
  location           String
  type               String           @default("Full-Time")
  experienceRequired String           @default("1-3 Years")
  description        String           @db.Text
  requirements       String           @db.Text
  isActive           Boolean          @default(true)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  applications       JobApplication[]
}

model JobApplication {
  id            String      @id @default(uuid())
  jobId         String?
  job           JobOpening? @relation(fields: [jobId], references: [id], onDelete: SetNull)
  position      String?
  appType       String?     @default("Job Application")
  candidateName String
  email         String
  phone         String
  experience    String?
  portfolioUrl  String?     @db.Text
  resumeUrl     String?     @db.Text
  coverLetter   String?     @db.Text
  status        String      @default("new")
  submittedAt   DateTime    @default(now())

  @@index([jobId])
}

model ContactInquiry {
  id                String   @id @default(uuid())
  name              String
  email             String
  phone             String
  serviceOfInterest String?
  message           String   @db.Text
  status            String   @default("new")
  createdAt         DateTime @default(now())
}

model CompanySettings {
  id                 String   @id @default("default")
  phonePrimary       String   @default("+91 98765 43210")
  phoneSecondary     String?
  emailSupport       String   @default("info@jplitsolution.com")
  emailCareers       String   @default("careers@jplitsolution.com")
  officeAddress      String   @default("Noida, Uttar Pradesh, India")
  googleMapsEmbedUrl String?  @db.Text
  linkedinUrl        String?
  twitterUrl         String?
  facebookUrl        String?
  instagramUrl       String?
  updatedAt          DateTime @updatedAt
}
