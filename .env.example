# Server Port
PORT=5000
NODE_ENV=production

# Database Connection (MySQL)
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE_NAME"

# Authentication Secret (Change this in production)
JWT_SECRET="generate_a_random_secure_jwt_secret_here"
ADMIN_DEFAULT_EMAIL="admin@jplitsolution.com"
ADMIN_DEFAULT_PASSWORD="your_secure_password"

# Allowed Frontend Origins for CORS (comma-separated)
CORS_ORIGIN="http://localhost:3000,https://jplitsolution.com"

# Supabase Storage (Optional)
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Cloudinary CDN Image Storage (Recommended for blazing fast images)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
